generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vehicle {
  id           String   @id @default(uuid())
  name         String
  category     String
  type         String
  pricePerDay  Float
  seats        Int
  transmission String
  fuel         String
  location     String
  available    Boolean  @default(true)
  image        String?
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]
}

model Lead {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  vehicleId       String
  pickUpLocation  String
  dropOffLocation String
  pickUpDate      DateTime
  dropOffDate     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Transaction {
  id        String   @id @default(uuid())
  carName   String
  image     String?
  type      String
  date      DateTime
  amount    Float
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BestSeller {
  id        String   @id @default(uuid())
  name      String
  category  String
  image     String?
  rentCount Int
  price     Float
}

model DashboardStat {
  id                String @id @default(uuid())
  weeklyEarnings    Float
  weeklyEarningsPct Float
  totalSales        Float
  totalSalesPct     Float
  purchasedGoods    Float
  purchasedGoodsPct Float
}

model SalesChartData {
  id    String @id @default(uuid())
  month String
  sales Float
}

model SalesByCountry {
  id      String @id @default(uuid())
  country String
  value   Float
}

model AiQueryCache {
  id          String   @id @default(uuid())
  promptKey   String   @unique
  explanation String
  vehicleIds  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([promptKey])
}
